# Terraform state, plans and caches never go to Git (state lives in GCS)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
*.tfvars
!*.tfvars.example
# NOTE: .terraform.lock.hcl IS committed on purpose (records exact provider versions)

# Credentials and kubeconfigs
*.json.key
*-key.json
credentials*.json
kubeconfig*
.kube/
.env.local
.git-credentials

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/
