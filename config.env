

# Where and what to build
REGION="us-central1"
ZONE="us-central1-a"
CLUSTER_NAME="gitops-demo"

# Node sizing (e2-standard-2 = 2 vCPU / 8 GB). Free-trial CPU quota is small,
# so keep NODE_MAX * 2 vCPU well under your regional quota.
MACHINE_TYPE="e2-standard-2"
NODE_MIN="2"
NODE_MAX="3"
DISK_SIZE_GB="50"
USE_SPOT="false"

# Git branch Argo CD watches
GIT_BRANCH="main"

# Pinned versions
ARGOCD_CHART_VERSION="10.3.2"        # Argo CD Helm chart (app version v3.5.0)
PODINFO_VERSION="6.14.0"             # initial app version
PODINFO_NEXT_VERSION="6.14.1"        # version used for the GitOps change demo
CURL_IMAGE="docker.io/curlimages/curl:8.20.0"
K6_IMAGE="docker.io/grafana/k6:1.7.1"

# Load test
LOAD_VUS="20"          # concurrent virtual users
LOAD_DURATION="3m"     # how long load is applied
